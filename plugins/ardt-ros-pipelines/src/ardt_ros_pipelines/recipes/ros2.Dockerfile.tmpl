# syntax=docker/dockerfile:1
# Rendered by `ardt pipe run ros-ci` (ardt-ros-pipelines @VERSION@) — machine-owned.
# The recipe lives in ardt-ros-pipelines and updates with the pinned ardt version;
# repos contain NO Dockerfile. A repo needing local image content extends the
# configured base via @BASE_FILE@ (spliced in below as a stage). Build, test and
# packaging are ONE recipe; building the `test` target proves the tests pass:
#   docker build -f <this file> --target test .   -> deps + build + TEST (the CI gate)
#   docker build -f <this file> .                 -> shipped runtime image (does NOT run tests)
# The runtime image deliberately does not depend on the test stage: depending on
# it made every foreign-arch runtime build re-run the whole suite under QEMU.
ARG BUILDER_IMAGE=@BUILDER@
ARG BASE_IMAGE=@BASE_IMAGE@

# ---- steps 1-2: deps + build (the shared root of test and runtime) ----
FROM ${BUILDER_IMAGE} AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git python3-pip openssh-client \
 && rm -rf /var/lib/apt/lists/*

# The same ardt tasks as on a dev machine run the build (two-plane rule).
@ARDT_INSTALL@
# The canonical colcon workspace, identical to the dev container's: this repo
# is ONE entry under /ws/src, `.repos` imports land grouped in /ws/src/external,
# and colcon runs from /ws so build/install/log land beside the sources.
# (The /ws rule's one implementation is ardt_core.config.workspace_root; this
# template hard-codes the same convention.)
# WORKDIR anchors ardt in this repo's config, not in the workspace root.
COPY . /ws/src/@PROJECT@
WORKDIR /ws/src/@PROJECT@

# 1) deps (exclusions come from ardt.yaml: tasks.ros.exclude_packages / rosdep_skip_keys)
RUN @GIT_MOUNTS@apt-get update && rosdep update --rosdistro ${ROS_DISTRO}@GIT_AUTH@ \
 && ardt deps \
 && rm -rf /var/lib/apt/lists/*
# 2) build (real files, not symlinks: the install base must survive the stage copy)
RUN ardt build --no-symlink-install --install-base @INSTALL_BASE@

# ---- steps 3-4: test + JUnit staging. Its own stage so NOTHING ships from it
# and nothing depends on it: the CI pipeline builds this target as the gate,
# the runtime images below fork from `build` directly. ----
FROM build AS test

# 3) test — red tests fail this target's build (same install base as the build)
RUN ardt test --install-base @INSTALL_BASE@
# 4) stage the JUnit XMLs where the pipeline (or a human) can copy them from
# (colcon's build base is at the workspace root, not inside the repo). Two
# layouts: ament_cmake writes <pkg>/test_results/<pkg>/*.xml, colcon's pytest
# step writes <pkg>/pytest.xml — the grouped find matches both.
RUN mkdir -p /results && cd /ws/build \
 && (find . \( -path '*test_results*' -name '*.xml' -o -name 'pytest.xml' \) -exec cp --parents -t /results {} +)
@STRIP@@BASE_EXT@
# ---- step 5: the shipped runtime image ----
FROM @RUNTIME_FROM@ AS runtime

COPY --from=@INSTALL_SRC@ @INSTALL_BASE@ @INSTALL_BASE@
# 5b) exec dependencies install HERE, not in the build stage: the runtime image
# starts from the configured base alone, and everything rosdep put into the
# builder would otherwise be missing at runtime. The install space's
# share/*/package.xml files are the manifest rosdep scans; --ignore-src skips
# the workspace's own (already copied) packages. An unresolvable key fails the
# image build — the earliest moment it can be caught.
RUN apt-get update \
 && { command -v rosdep >/dev/null 2>&1 \
      || apt-get install -y --no-install-recommends python3-rosdep; } \
 && { [ -f /etc/ros/rosdep/sources.list.d/20-default.list ] || rosdep init; } \
 && rosdep update --rosdistro ${ROS_DISTRO} \
 && rosdep install --from-paths @INSTALL_BASE@ --ignore-src -y \
      --rosdistro ${ROS_DISTRO} --dependency-types exec@RUNTIME_SKIP@ \
 && rm -rf /var/lib/apt/lists/* /root/.ros/rosdep
@CMD@
